# Copy to .env and fill in every password; the stack does not start while one is empty.
# Generate them e.g. with: openssl rand -base64 24
STORAGEKEEPER_VERSION=latest
# Superuser of PostgreSQL, only for administration
POSTGRES_PASSWORD=
# Database login of the app and of Keycloak (each only sees its own database)
STORAGEKEEPER_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# URL under which clients reach Keycloak; must match the issuer in the tokens.
KEYCLOAK_URL=http://localhost:8180
# URL under which browsers reach the app (allowed redirect after the Swagger UI login).
STORAGEKEEPER_URL=http://localhost:8080
# false hides Swagger UI and /v3/api-docs
STORAGEKEEPER_API_DOCS_ENABLED=true