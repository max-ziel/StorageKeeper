{
  "realm": "storagekeeper",
  "displayName": "StorageKeeper (lokale Entwicklung)",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "storagekeeper-web",
      "name": "StorageKeeper (Browser)",
      "description": "Anmeldung im Browser per Authorization Code mit PKCE, z. B. über die Swagger UI. Ohne Passwort-Grant.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8080/swagger-ui/oauth2-redirect.html"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "audience storagekeeper-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "storagekeeper-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "storagekeeper-cli",
      "name": "StorageKeeper CLI / Swagger UI",
      "description": "Nur für lokale Entwicklung: holt Tokens per Benutzername und Passwort.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience storagekeeper-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "storagekeeper-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.org",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Beispiel",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.org",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Beispiel",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.org",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Beispiel",
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }]
    }
  ]
}