{
  "realm": "storagekeeper",
  "displayName": "StorageKeeper (lokale Entwicklung)",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "storagekeeper-cli",
      "name": "StorageKeeper CLI / Swagger UI",
      "description": "Nur für lokale Entwicklung: holt Tokens per Benutzername und Passwort.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience storagekeeper-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "storagekeeper-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.org",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Beispiel",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.org",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Beispiel",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    }
  ]
}